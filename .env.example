# ========================================
# Pro-Qual-Fraud-Eval · 环境变量配置模板
# ========================================
# 使用方法：复制本文件为 .env 并填入你自己的值
#   cp .env.example .env

# ---------- 看板 Push API 鉴权 ----------
DASH_PUSH_TOKEN=change-me-to-a-secure-token
DASH_HMAC_SECRET=

# ---------- 工作流状态推送 ----------
WORKFLOW_PUSH_TOKEN=pqfe-workflow-push-token-change-in-prod

# ---------- 标注平台 URL ----------
ANNOTATION_PLATFORM_URL=http://localhost:3001

# ---------- 标注结果落地表格 URL ----------
RESULT_STORE_URL=https://docs.example.com/sheet/your_result_sheet_id

# ---------- 数据库连接 (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qual_annotation

# ---------- SSO / 认证 ----------
# 本地开发时设置为 1 会绕过 SSO 鉴权 (生产必须关闭)
ENABLE_DEV_AUTH=1
SSO_COOKIE_FILE=~/.config/pqfe/sso.json

# ---------- 高危模板自动入库 ----------
# 内网接口调用凭证 / 证书
MITM_CA_PATH=~/.config/pqfe/ca-cert.pem
# 自动化上传接口鉴权 Token
HRM_AUTOMATION_UPLOAD_TOKEN=change-me
# VLM 判定网关地址（高危模板机器人使用）
VLM_ENDPOINT=https://llm-gateway.example.com/v1/chat/completions

# ---------- 聚类跑批执行器 ----------
# 跑批服务后端地址与鉴权
CLUSTER_SERVICE_URL=https://app.example.com/s/cluster-service
WORKFLOW_RUNNER_TOKEN=change-me

# ---------- 周度实锤审核对比（badcase 拉拦截） ----------
# 风控命中日志接口地址（无需要时留空，脚本回退到可读桩）
RISK_HITLOG_API=
RISK_HITLOG_SKILL_DIR=~/.openclaw/workspace/skills/risk-hitlog-factor/scripts
# 跑批执行器工作目录
WORKDIR=~/tmp

# ---------- 项目根目录 ----------
PROJECT_ROOT=./
